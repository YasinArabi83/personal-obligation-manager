# Copy this file to `.env` and fill in real values. `.env` is git-ignored — never commit secrets.
# Production must override every value via the deployment's environment (Docker env_file / host secret),
# not via committed appsettings. See docs/SECURITY.md §3.

# ---- Database ----
POSTGRES_PASSWORD=change-me

# ---- JWT (access-token signing) ----
# At least 32 bytes (256 bits). Generate one, e.g. `openssl rand -base64 48`.
# In the ASP.NET Core app this is bound as Jwt:SigningKey (env var Jwt__SigningKey).
Jwt__SigningKey=change-me-to-a-32+-byte-random-secret
Jwt__Issuer=pom
Jwt__Audience=pom-web

# ---- SMS provider (task 0017 wires the real sms.ir adapter; default is the dev Logging sender) ----
SMS_PROVIDER_API_KEY=
Sms__Provider=Logging

# ---- MinIO / object storage ----
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
