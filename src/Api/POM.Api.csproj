<Project Sdk="Microsoft.NET.Sdk.Web">

	<!--
    API layer: ASP.NET Core minimal API / controllers, DTOs, request validation,
    auth wiring. Depends on Application only (Infrastructure is referenced in
    Program.cs purely for DI composition-root wiring, added in task 0002).
  -->
	<PropertyGroup>
		<RootNamespace>POM</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Application\POM.Application.csproj" />
		<!--
      Composition-root exception (docs/ARCHITECTURE.md §2): the API layer references
      Infrastructure ONLY so Program.cs can call AddInfrastructure for DI registration.
      Controllers/Application services never touch Infrastructure types directly.
    -->
		<ProjectReference Include="..\Infrastructure\POM.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- JWT bearer validation for the access tokens minted by Infrastructure's JwtTokenService (0004). -->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />

	</ItemGroup>

</Project>
