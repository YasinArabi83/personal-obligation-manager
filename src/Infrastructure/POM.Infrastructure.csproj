<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure layer: EF Core (DbContext, configurations, migrations),
    PostgreSQL, concrete ISmsSender/IFileStorage implementations, background jobs.
    Depends on Application (and Domain transitively). Never referenced by Api
    except through DI registration in the composition root.
  -->
  <PropertyGroup>
    <RootNamespace>POM</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\POM.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <!-- Pinned to unify the version pulled transitively by the Npgsql provider (which otherwise
         resolves to an older patch), so API and tests bind one EF Core Relational assembly. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

</Project>
